{
  "name": "agenda-cobranza",
  "version": "1.0.0",
  "description": "Agenda de gestiones de cobranza — Hadad & Asociados",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild:win": "node scripts/write-version.js",
    "build:win": "electron-packager . AgendaCobranza --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico",
    "postbuild:win": "node scripts/copy-extras.js",
    "release": "node scripts/release.js",
    "build:mac": "electron-packager . AgendaCobranza --platform=darwin --arch=x64 --out=dist --overwrite"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2"
  },
  "author": "Hadad & Asociados",
  "license": "MIT"
}
